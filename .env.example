
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60


DASHSCOPE_API_KEY=your-dashscope-api-key
ROUTER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ROUTER_MODEL_NAME=qwen-flash
TEMPERATURE=0.7


INTENT_MODEL_ENABLED=false

INTENT_MODEL_DIR=./model


MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:9123/mcp

MCP_SERVICE_TOKEN=replace-with-a-service-to-service-secret
MCP_CONTEXT_JWT_SECRET=replace-with-a-separate-random-secret
MCP_CONTEXT_JWT_ALGORITHM=HS256
MCP_CONTEXT_TOKEN_TTL_SECONDS=300


MEMORY_ENABLED=true
MEMORY_DIR=data/sessions/memory
MEMORY_USER_ID=default
MAX_LTM_FACTS=50
PREFERENCE_MEMORY_TTL_DAYS=90
SEMANTIC_MEMORY_RETRIEVAL_TOP_K=2

MEMORY_STORAGE_BACKEND=postgres
MEMORY_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/ecom_agent
MEMORY_REDIS_URL=redis://127.0.0.1:6379/0

MEMORY_CACHE_TTL_SECONDS=1800
MEMORY_CACHE_KEY_PREFIX=ecom:ltm


API_JWT_SECRET=replace-with-a-random-secret
API_JWT_ALGORITHM=HS256

API_AUTH_USERS=

API_AUTH_TOKEN_TTL_SECONDS=86400


ORDER_DB_DSN=mysql://ecom:ecom_dev_password@127.0.0.1:3307/ecom_agent_orders
ORDER_DB_POOL_SIZE=10
ORDER_DB_POOL_TIMEOUT=5

ORDER_CACHE_REDIS_URL=redis://127.0.0.1:6379/0
ORDER_CACHE_TTL_SECONDS=300

ORDER_PLATFORM_CODES=pdd

API_SESSION_STORAGE_BACKEND=postgres
API_SESSION_POSTGRES_DSN=postgresql://postgres:postgres@127.0.0.1:5432/ecom_agent
# 人工客服持久化；留空复用 API_SESSION_POSTGRES_DSN。SQLite 仅用于本地单进程演示。
SUPPORT_DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CONTEXT_INPUT_BUDGET_TOKENS=192000
CONTEXT_COMPACTION_TRIGGER_RATIO=0.70
CONTEXT_COMPACTION_RETAIN_RATIO=0.40


SKILLS_ENABLED=true
SKILLS_DIR=app/skills/definitions


EVAL_DATASET_PATH=app/evaluation/cases.json
EVAL_OUTPUT_PATH=data/evaluation/eval_report.json
EVAL_USE_JUDGE=true
EVAL_PASS_THRESHOLD=0.6


EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL_PATH=model/bge-small-zh-v1.5
EMBEDDING_MODEL=text-embedding-3-small
KB_DIR=app/rag/knowledge

RAG_BACKEND=chroma
CHROMA_PERSIST_DIR=data/rag/chroma
KB_MANIFEST_PATH=data/rag/kb_manifest.json
CHROMA_COLLECTION=ecom_kb


API_MAX_CONCURRENT_LLM=8

API_PG_POOL_MIN_SIZE=1
API_PG_POOL_MAX_SIZE=10
API_PG_POOL_TIMEOUT=5
API_PG_CONNECT_TIMEOUT=5

API_RAG_SEARCH_CONCURRENCY=2


API_CONCURRENCY_REDIS_URL=redis://127.0.0.1:6379/0
API_DISTRIBUTED_LEASE_SECONDS=90
API_QUEUE_WAIT_SECONDS=2

API_CHAT_EXECUTION_MODE=async

API_CHAT_WORKER_ENABLED=false
API_CHAT_WORKER_CONCURRENCY=2
API_CHAT_QUEUE_PREFIX=ecom:chat
API_CHAT_QUEUE_MAX_DEPTH=1000
API_CHAT_JOB_TTL_SECONDS=3600
