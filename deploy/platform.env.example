# Merge these settings into deployment secrets/configuration. Do not put real
# passwords or service keys in this tracked example.
API_CHAT_WORKER_CONCURRENCY=2
API_CHAT_QUEUE_PREFIX=ecom:production
API_CHAT_QUEUE_MAX_DEPTH=1000
API_CHAT_QUEUE_TIMEOUT_SECONDS=120
API_CHAT_RUN_TIMEOUT_SECONDS=600
API_MAX_CONCURRENT_LLM=8
API_TENANT_AGENT_CONCURRENCY=4
API_GLOBAL_RPM=1200
API_TENANT_RPM=600
API_USER_RPM=60
API_USER_TENANTS={"customer-a":"shop-a","customer-b":"shop-b"}
CASE_STORAGE_BACKEND=postgres
API_PG_POOL_MIN_SIZE=1
API_PG_POOL_MAX_SIZE=10
API_PG_POOL_TIMEOUT=5
API_SSE_MAX_CONNECTIONS=2000
API_SSE_PER_USER=5
API_SSE_SEND_TIMEOUT_SECONDS=10
API_SSE_CATCHUP_SECONDS=15
MODEL_MAX_CONCURRENCY=8
MODEL_RPM=120
MODEL_TOKEN_BUDGET_PER_MINUTE=1000000
MODEL_MAX_OUTPUT_TOKENS=2048
MODEL_QUEUE_WAIT_SECONDS=3
EMBEDDING_MAX_CONCURRENCY=4
EMBEDDING_RPM=120
EMBEDDING_TOKEN_BUDGET_PER_MINUTE=1000000
# Independent retrieval: set URL only on API/Workers, leave it empty on the
# retrieval service. Set the same >=32-character secret token in both roles.
RETRIEVAL_SERVICE_URL=
RETRIEVAL_SERVICE_TOKEN=
RETRIEVAL_TIMEOUT_SECONDS=15
RETRIEVAL_GLOBAL_CONCURRENCY=8
RETRIEVAL_LOCAL_WAIT_SECONDS=0.1
# OpenAI-compatible embedding provider may differ from the chat provider.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
