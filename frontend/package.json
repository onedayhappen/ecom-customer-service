{
  "name": "ecom-customer-service-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write src tests *.js *.json README.md",
    "format:check": "prettier --check src tests *.js *.json README.md",
    "check": "npm run format:check && npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "lucide-react": "1.25.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2",
    "vite": "8.1.6",
    "@vitejs/plugin-react": "6.0.3"
  }
}
